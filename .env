# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit your real credentials.

# CUPS web admin login (used at http://<host-ip>:631)
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASSWORD=change_me_please

# Container timezone - affects log timestamps
TZ=Asia/Kuala_Lumpur

# Seconds between USB hotplug checks (see README). 0 disables the watchdog.
WATCHDOG_INTERVAL=20
